# Betriebsmodus:
#   single = genau ein Bildungsanbieter auf einer Domain (Selbsthosting)
#   saas   = viele Mandanten unter <kürzel>.<APP_DOMAIN> oder eigener Subdomain
APP_MODE=single

# Domain der Instanz ohne Protokoll und Port, z. B. zertifikate.meine-akademie.de
# (single) oder certifybird.com (saas). Im Produktivbetrieb Pflicht: Daraus
# entstehen die Links in den Anmelde-Mails.
# Lokal funktioniert "localhost": Mandanten sind im SaaS-Modus dann unter
# http://<kürzel>.localhost:3000 erreichbar.
APP_DOMAIN=localhost

# PostgreSQL. Die Zugangsdaten passen zur Datenbank aus docker-compose.dev.yml.
DATABASE_URL=postgresql://certifybird:certifybird@localhost:5432/certifybird

# Erster Bildungsanbieter und erste Person mit Zugang. "pnpm db:seed" legt
# beides nur an, wenn es noch fehlt.
ORG_NAME="Demo Akademie"
# ORG_SLUG=demo
ADMIN_EMAIL=admin@example.org

# E-Mail-Versand per SMTP. Die Werte hier passen zum Test-Postfach (Mailpit)
# aus docker-compose.dev.yml, Oberfläche unter http://localhost:8025.
# Beispiel IONOS: SMTP_HOST=smtp.ionos.de, SMTP_PORT=587, SMTP_USER und
# SMTP_FROM = die Adresse des Postfachs, SMTP_PASSWORD = dessen Passwort.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Certify Bird <noreply@example.org>"
