# Betriebsmodus:
#   single = genau ein Bildungsanbieter auf einer Domain (Selbsthosting)
#   saas   = viele Mandanten unter <kürzel>.<APP_DOMAIN> oder eigener Subdomain
APP_MODE=single

# Basis-Domain ohne Protokoll und Port. Im SaaS-Modus Pflicht, z. B. certifybird.com.
# Lokal funktioniert "localhost": Mandanten sind dann unter http://<kürzel>.localhost:3000 erreichbar.
APP_DOMAIN=localhost

# PostgreSQL. Die Zugangsdaten passen zur Datenbank aus docker-compose.dev.yml.
DATABASE_URL=postgresql://certifybird:certifybird@localhost:5432/certifybird

# Name des ersten Bildungsanbieters, den "pnpm db:seed" anlegt (nur wenn noch keiner existiert).
ORG_NAME=Demo Akademie
# Optional: Kürzel statt des automatisch aus dem Namen gebildeten.
# ORG_SLUG=demo
