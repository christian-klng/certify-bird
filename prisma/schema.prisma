generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Ein Mandant: der Bildungsanbieter, der Zertifikate ausstellt.
/// Im Modus "single" gibt es genau einen, im Modus "saas" beliebig viele.
model Organization {
  id   String @id @default(uuid())
  name String

  /// Aktuelles Kürzel, ergibt im SaaS-Modus <slug>.<APP_DOMAIN>.
  slug String @unique

  /// Mitgebrachte Subdomain (per CNAME). Gilt erst, wenn sie geprüft wurde.
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  retiredSlugs RetiredSlug[]
  memberships  Membership[]
  loginTokens  LoginToken[]
  templates    CertificateTemplate[]
  issuances    Issuance[]
  certificates Certificate[]
  signingKey   SigningKey?
  quizzes      Quiz[]
  candidates   QuizCandidate[]
}

/// Früher benutzte Kürzel. Sie werden nie neu vergeben und zeigen weiter auf
/// den Mandanten, weil ausgestellte Zertifikate auf die alte Adresse verweisen.
/// Wird der Mandant gelöscht, bleibt das Kürzel gesperrt.
model RetiredSlug {
  slug           String        @id
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  retiredAt      DateTime      @default(now())

  @@index([organizationId])
}

/// Eine Person, die sich anmelden kann. Global über die E-Mail-Adresse,
/// die Zugehörigkeit zu Mandanten regelt Membership.
model User {
  id        String   @id @default(uuid())
  /// Immer kleingeschrieben gespeichert.
  email     String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
  sessions    Session[]
}

enum MemberRole {
  OWNER
  MEMBER
}

/// Zugehörigkeit einer Person zu einem Mandanten.
model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

enum LoginTokenPurpose {
  /// Anmeldung bei einem Mandanten: als Mitglied oder als Person mit Zertifikat.
  LOGIN
  /// Bestätigung einer Registrierung; legt den Mandanten erst beim Einlösen an.
  REGISTER
}

/// Einmal-Token aus dem Magic Link. Gespeichert wird nur der Hash.
model LoginToken {
  id        String            @id @default(uuid())
  tokenHash String            @unique
  purpose   LoginTokenPurpose
  email     String

  /// Bei LOGIN: der Mandant, für den der Link gilt.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Bei REGISTER: die gewünschten Angaben des neuen Mandanten.
  pendingOrgName String?
  pendingOrgSlug String?

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// Angemeldete Sitzung. Der Cookie enthält das Token, die Datenbank nur den Hash.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Zertifikatsvorlage eines Mandanten: das Aussehen des PDFs und der
/// Beschreibungstext des Leistungsnachweises.
model CertificateTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  /// Längerer Text, der den Leistungsnachweis beschreibt (für die öffentliche
  /// Zertifikatsseite und das Open Badge).
  description String @default("")

  /// Gestaltung im Format von pdfme: Seitengröße oder Hintergrund-PDF und Felder.
  design Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issuances Issuance[]

  @@index([organizationId])
}

/// Eine Kohorte (in der Oberfläche so genannt): ein Durchgang eines Kurses mit
/// fester Vorlage. Personen werden eingetragen (QuizCandidate) und bekommen
/// später ihr Zertifikat. Mit dem ersten Zertifikat hält die Kohorte fest, wie
/// die Vorlage aussieht; spätere Änderungen an der Vorlage oder ihr Löschen
/// ändern ausgestellte Zertifikate nicht.
model Issuance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Die Vorlage der Kohorte. Bis zum ersten Zertifikat wird aus ihr kopiert.
  templateId String?
  template   CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Titel der Weiterbildung, Platzhalter {kurs}.
  courseTitle String
  /// Name des Anbieters zum Zeitpunkt der Ausstellung, Platzhalter {anbieter}.
  issuerName  String
  /// Ausstellungsdatum, Platzhalter {datum}.
  issuedOn    DateTime @db.Date

  /// Kopien aus der Vorlage; maßgeblich ab dem ersten Zertifikat.
  description String
  design      Json

  /// Das Quiz, das für diese Ausstellung verlangt wird; nur zur Orientierung.
  quizId  String?
  quizRef Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)
  /// Kopie des Quiz zum Zeitpunkt der Ausstellung (siehe src/lib/quizzes/quiz.ts).
  /// Ist sie gesetzt, gibt es ein Zertifikat erst nach bestandenem Quiz.
  quiz    Json?

  createdAt DateTime @default(now())

  certificates Certificate[]
  candidates   QuizCandidate[]

  @@index([organizationId])
}

/// Ein Zertifikat für eine teilnehmende Person.
model Certificate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issuanceId     String
  issuance       Issuance     @relation(fields: [issuanceId], references: [id], onDelete: Cascade)

  /// Platzhalter {name}.
  recipientName  String
  /// Immer klein geschrieben; darüber meldet sich die Person später an.
  recipientEmail String

  /// Wann die Person per E-Mail von ihrem Zertifikat erfahren hat.
  notifiedAt  DateTime?
  /// Gesetzt, solange die Person in die öffentliche Seite eingewilligt hat.
  /// Ohne diesen Wert ist das Zertifikat für Dritte nicht sichtbar.
  publishedAt DateTime?

  /// Ergebnis des bestandenen Quiz, falls die Ausstellung eines verlangt.
  quizCorrect Int?
  quizTotal   Int?

  createdAt DateTime @default(now())

  consentEvents ConsentEvent[]

  @@unique([issuanceId, recipientEmail])
  @@index([organizationId, recipientEmail])
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

/// Nachweis der Einwilligung in die Veröffentlichung: wer wann welchem
/// Wortlaut zugestimmt oder widerrufen hat. Wird nur ergänzt, nie geändert.
model ConsentEvent {
  id            String        @id @default(uuid())
  certificateId String
  certificate   Certificate   @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  action        ConsentAction
  /// Fassung des Einwilligungstexts, siehe src/lib/certificates/consent.ts.
  textVersion   String
  createdAt     DateTime      @default(now())

  @@index([certificateId])
}

/// Schlüsselpaar eines Mandanten, mit dem er seine Open Badges signiert.
/// Der öffentliche Teil ist unter /badges/keys/<id> abrufbar.
model SigningKey {
  /// Zugleich die Schlüsselkennung (kid) in der Adresse des öffentlichen Schlüssels.
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  publicJwk  Json
  /// Geheim. Verlässt die Datenbank nur zum Signieren.
  privateJwk Json

  createdAt DateTime @default(now())
}

/// Ein Quiz als Leistungsabfrage: Fragen mit Antworten zum Ankreuzen.
model Quiz {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  /// Einleitung, Bestehensgrenze, Zahl der Versuche und Fragen
  /// (siehe src/lib/quizzes/quiz.ts).
  content Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issuances Issuance[]

  @@index([organizationId])
}

/// Eine Person, die in einer Kohorte eingetragen ist und noch kein Zertifikat
/// hat. Verlangt die Kohorte ein Quiz, muss sie es bestehen; sonst stellt die
/// Verwaltung aus. In beiden Fällen wird daraus ein Zertifikat und dieser
/// Eintrag verschwindet. (Der Name stammt aus der Zeit, als es Einträge nur
/// mit Quiz gab.)
model QuizCandidate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issuanceId     String
  issuance       Issuance     @relation(fields: [issuanceId], references: [id], onDelete: Cascade)

  name  String
  /// Immer klein geschrieben; darüber meldet sich die Person an.
  email String

  /// Wann die Person per E-Mail zum Quiz eingeladen wurde.
  notifiedAt  DateTime?
  /// Zahl der abgegebenen Versuche und das Ergebnis des letzten.
  attempts    Int       @default(0)
  lastCorrect Int?
  lastTotal   Int?

  createdAt DateTime @default(now())

  @@unique([issuanceId, email])
  @@index([organizationId, email])
}
