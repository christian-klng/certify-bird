generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Ein Mandant: der Bildungsanbieter, der Zertifikate ausstellt.
/// Im Modus "single" gibt es genau einen, im Modus "saas" beliebig viele.
model Organization {
  id   String @id @default(uuid())
  name String

  /// Aktuelles Kürzel, ergibt im SaaS-Modus <slug>.<APP_DOMAIN>.
  slug String @unique

  /// Mitgebrachte Subdomain (per CNAME). Gilt erst, wenn sie geprüft wurde.
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  retiredSlugs RetiredSlug[]
}

/// Früher benutzte Kürzel. Sie werden nie neu vergeben und zeigen weiter auf
/// den Mandanten, weil ausgestellte Zertifikate auf die alte Adresse verweisen.
/// Wird der Mandant gelöscht, bleibt das Kürzel gesperrt.
model RetiredSlug {
  slug           String        @id
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  retiredAt      DateTime      @default(now())

  @@index([organizationId])
}
